{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  // test-ui has its own oxlint config and scripts.
  "ignorePatterns": ["test-ui/**", "**/node_modules/**", "**/.venv/**", ".local/**"]
}
