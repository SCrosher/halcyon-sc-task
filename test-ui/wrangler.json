{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halcyon-test-ui",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": {
      "name": "halcyon-test-ui-staging",
      "routes": [
        {
          "pattern": "staging-app.joinhalcyon.app",
          "custom_domain": true
        }
      ],
      "workers_dev": false,
      "preview_urls": false
    },
    "production": {
      "name": "halcyon-test-ui-production",
      "routes": [
        {
          "pattern": "app.joinhalcyon.app",
          "custom_domain": true
        }
      ],
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
