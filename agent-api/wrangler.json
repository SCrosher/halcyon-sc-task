{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halcyon-agent-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "halcyon-agent-api-staging",
      "routes": [
        {
          "pattern": "staging-api.joinhalcyon.app",
          "custom_domain": true
        }
      ],
      "workers_dev": false,
      "preview_urls": false,
      "containers": [
        {
          "class_name": "AgentApiContainer",
          "image": "./Dockerfile",
          "max_instances": 1
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "class_name": "AgentApiContainer",
            "name": "AGENT_API"
          }
        ]
      },
      "exports": {
        "AgentApiContainer": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "halcyon-agent-staging",
          "database_id": "6aa6ffa2-95d8-43d4-ac1a-e92a2c1d5f00",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "HALCYON_ENV": "staging",
        "ANTHROPIC_MODEL": "claude-opus-5-5",
        "AGENT_EFFORT": "low",
        "ANTHROPIC_FALLBACKS": "default",
        "CORS_ORIGINS": "*"
      }
    },
    "production": {
      "name": "halcyon-agent-api-production",
      "routes": [
        {
          "pattern": "api.joinhalcyon.app",
          "custom_domain": true
        }
      ],
      "workers_dev": false,
      "preview_urls": false,
      "containers": [
        {
          "class_name": "AgentApiContainer",
          "image": "./Dockerfile",
          "max_instances": 1
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "class_name": "AgentApiContainer",
            "name": "AGENT_API"
          }
        ]
      },
      "exports": {
        "AgentApiContainer": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "halcyon-agent-production",
          "database_id": "",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "HALCYON_ENV": "production",
        "ANTHROPIC_MODEL": "claude-opus-5-5",
        "AGENT_EFFORT": "low",
        "ANTHROPIC_FALLBACKS": "default",
        "CORS_ORIGINS": "*"
      }
    }
  }
}
